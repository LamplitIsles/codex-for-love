{
  "name": "codex-for-love",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm --filter @lamplitisles/partner build",
    "check": "pnpm --filter @lamplitisles/partner check",
    "test": "node --test scripts/launcher.test.mjs && pnpm --filter @lamplitisles/partner test",
    "start": "pnpm --filter @lamplitisles/partner start",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:check": "node scripts/pack-check.mjs",
    "release:smoke": "node scripts/artifact-smoke.mjs",
    "release:preflight": "node scripts/publish-preflight.mjs"
  }
}
